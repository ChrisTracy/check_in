# Port and interface to listen on
PORT=3000
HOST=0.0.0.0

# SQLite database file (created automatically)
DB_PATH=data/checkin.db

# History entries kept per record. 0 = no history, -1 = unlimited.
HISTORY_LIMIT=100

# Optional: the API key to use on first start (otherwise one is generated). Check-ins require it.
# Power users and admins can see or regenerate it on the Add Device page or in Admin > API key.
API_KEY=

# Optional: create the first admin automatically (otherwise the login page asks you to create one)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to encrypt the stored SSO client secret and sign-in cookies.
# If empty, one is generated and saved next to the database (data/.app-secret).
APP_SECRET=

# How long a browser sign-in lasts without activity (hours)
SESSION_TTL_HOURS=12

# Set when running behind a reverse proxy / load balancer that terminates HTTPS
# (true, a hop count like 1, or a comma-separated list of proxy IPs)
TRUST_PROXY=

# Secure cookies: auto (when the request is HTTPS), true or false
COOKIE_SECURE=auto

# Optional: allow browser calls from another origin (e.g. https://example.com or *)
CORS_ORIGIN=

# Max writes committed per SQLite transaction
MAX_BATCH=5000
# Max fields per record
MAX_FIELDS=500
# Max JSON/form body size (MB)
BODY_LIMIT_MB=10
# Max CSV upload size (MB)
IMPORT_LIMIT_MB=200
# silent | error | warn | info | debug
LOG_LEVEL=warn

# Host port published by docker compose
PUBLISH_PORT=3000

# Host port published by docker compose for built-in HTTPS (Admin → HTTPS)
PUBLISH_HTTPS_PORT=3443

# Port the built-in HTTPS server listens on (outside Docker)
HTTPS_PORT=3443

# Break-glass: set to true to force HTTP only if an HTTPS setting locks you out
TLS_DISABLE=false

# Optional alerts for new issues: address of an Apprise API server (the compose files already start one at http://apprise:8000).
# Can also be set in Settings -> Alerts. Leave empty for no alerts.
APPRISE_URL=
